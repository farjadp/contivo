generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id           String         @id @default(cuid())
  clerkId      String?        @unique
  passwordHash String?
  email        String         @unique
  name         String?
  avatarUrl    String?
  plan         UserPlan       @default(FREE)
  role         UserRole       @default(USER)
  createdAt    DateTime       @default(now())
  updatedAt    DateTime       @updatedAt
  aiUsageLogs  AiUsageLog[]
  contentItems ContentItem[]
  contentJobs  ContentJob[]
  creditLedger CreditLedger[]
  subscription Subscription?
  workspaces   Workspace[]

  @@index([clerkId])
  @@index([email])
  @@map("users")
}

model Subscription {
  id                   String             @id @default(cuid())
  userId               String             @unique
  stripeCustomerId     String             @unique
  stripeSubscriptionId String?            @unique
  stripePriceId        String?
  plan                 UserPlan           @default(FREE)
  status               SubscriptionStatus @default(ACTIVE)
  creditAllowance      Int                @default(100)
  currentPeriodStart   DateTime?
  currentPeriodEnd     DateTime?
  createdAt            DateTime           @default(now())
  updatedAt            DateTime           @updatedAt
  user                 User               @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([stripeCustomerId])
  @@map("subscriptions")
}

model Workspace {
  id                   String               @id @default(cuid())
  userId               String
  name                 String
  websiteUrl           String?
  status               WorkspaceStatus      @default(PENDING)
  brandSummary         Json?
  audienceInsights     Json?
  rescrapeCount        Int                  @default(0)
  archivedSummaries    Json?
  createdAt            DateTime             @default(now())
  updatedAt            DateTime             @updatedAt
  competitorKeywords   CompetitorKeyword[]
  competitors          Competitor[]
  contentItems         ContentItem[]
  contentJobs          ContentJob[]
  keywordOpportunities KeywordOpportunity[]
  serpAnalyses         SerpAnalysis[]
  socialConnections    SocialConnection[]
  strategyRuns         StrategyRun[]
  strategicReports     StrategicReport[]
  autopilotPolicies    AutopilotPolicy[]
  autopilotRuns        AutopilotRun[]
  siteConnections      SiteConnection[]
  narrative            Narrative?
  evidence             Evidence[]
  user                 User                 @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("workspaces")
}

/// Per-workspace autopilot configuration. One policy per workspace; when
/// `enabled` the runner ideates + drafts + schedules content with no human
/// in the loop. Publishing itself is still handled by SocialSchedulerService
/// once an item is SCHEDULED and its time arrives.
/// One agent. A workspace can run several: a LinkedIn voice, a blog writer,
/// a competitor watcher — each with its own cadence, channels and steering.
/// `recipeKey` records which preset it was created from, so the UI can show
/// what it is without re-deriving it from the settings.
model AutopilotPolicy {
  id          String    @id @default(cuid())
  workspaceId String
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  userId      String

  name      String  @default("Autopilot")
  recipeKey String?

  enabled Boolean @default(false)

  // How much and where
  postsPerWeek Int              @default(3)
  channels     ContentChannel[]

  // When posts may go live (local time in `timezone`)
  timezone        String @default("America/Toronto")
  windowStartHour Int    @default(9)
  windowEndHour   Int    @default(18)
  publishDays     Int[]  @default([1, 2, 3, 4, 5]) // 0=Sun … 6=Sat

  // Steering
  goal         String?
  topicHints   String[] @default([])
  avoidTopics  String[] @default([])
  /// Which storylines this agent advances. Empty means every enabled storyline
  /// on the workspace, so an agent created before the narrative layer keeps
  /// working and quietly gains a position once one exists.
  storylineIds String[] @default([])

  // Scheduling bookkeeping
  lastRunAt DateTime?
  nextRunAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  runs         AutopilotRun[]
  contentItems ContentItem[]

  @@index([enabled, nextRunAt])
  @@index([userId])
  @@index([workspaceId])
  @@map("autopilot_policies")
}

enum AutopilotRunStatus {
  RUNNING
  SUCCEEDED
  PARTIAL
  FAILED
  SKIPPED
}

/// One row per runner execution for a policy. `log` holds a step-by-step
/// JSON trail (ideas generated, items scheduled, channels skipped and why)
/// so a hands-off user can still audit what the machine did.
model AutopilotRun {
  id          String          @id @default(cuid())
  policyId    String
  policy      AutopilotPolicy @relation(fields: [policyId], references: [id], onDelete: Cascade)
  workspaceId String
  workspace   Workspace       @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  status  AutopilotRunStatus @default(RUNNING)
  trigger String             @default("cron") // cron | manual

  ideasGenerated Int @default(0)
  itemsScheduled Int @default(0)
  itemsSkipped   Int @default(0)

  log   Json?
  error String?

  startedAt  DateTime  @default(now())
  finishedAt DateTime?

  @@index([workspaceId, startedAt])
  @@index([policyId])
  @@map("autopilot_runs")
}

enum SiteConnectionStatus {
  ACTIVE
  DISABLED
  REVOKED
}

/// A website that pulls its published content from Contivo. One row per site;
/// the API key is stored only as a SHA-256 hash (`keyHash`) — the plaintext is
/// shown to the user once at creation and never persisted. `keyPrefix` is the
/// short visible fragment used to identify a key in the UI.
model SiteConnection {
  id          String    @id @default(cuid())
  workspaceId String
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  userId      String

  name    String
  siteUrl String
  status  SiteConnectionStatus @default(ACTIVE)

  keyHash   String @unique
  keyPrefix String

  /// Optional endpoint pinged after a post is published so the site can
  /// revalidate its cache. Called with the secret as a Bearer token.
  revalidateUrl    String?
  revalidateSecret String?

  lastFetchedAt        DateTime?
  lastRevalidateAt     DateTime?
  lastRevalidateStatus Int?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([workspaceId])
  @@index([userId])
  @@map("site_connections")
}

model StrategicReport {
  id          String    @id @default(cuid())
  workspaceId String
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  userId      String

  // File paths
  docxPath String
  pdfPath  String

  // Metadata
  reportDate       DateTime @default(now())
  fileSize         Int
  sectionsIncluded Json

  // Analytics snapshot (frozen at generation time)
  competitorsCount Int
  keywordsAnalyzed Int
  chartsGenerated  Int

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([workspaceId])
  @@index([userId])
  @@index([reportDate])
  @@map("strategic_reports")
}

model Competitor {
  id            String    @id @default(cuid())
  workspaceId   String
  name          String
  domain        String?
  description   String?
  category      String?
  audienceGuess String?
  source        String    @default("AI")
  type          String?
  userDecision  String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  workspace     Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@index([workspaceId])
  @@map("competitors")
}

model CompetitorKeyword {
  id               String    @id @default(cuid())
  workspaceId      String
  competitorDomain String
  keyword          String
  searchVolume     Int       @default(0)
  difficulty       Int       @default(0)
  competition      Float     @default(0)
  rankingPosition  Int?
  rankingUrl       String?
  createdAt        DateTime  @default(now())
  workspace        Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@index([workspaceId])
  @@index([workspaceId, competitorDomain])
  @@map("competitor_keywords")
}

model KeywordOpportunity {
  id               String    @id @default(cuid())
  workspaceId      String
  keyword          String
  searchVolume     Int       @default(0)
  competition      Float     @default(0)
  opportunityScore Float     @default(0)
  sourceCompetitor String?
  createdAt        DateTime  @default(now())
  workspace        Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@index([workspaceId])
  @@index([workspaceId, opportunityScore])
  @@map("keyword_opportunities")
}

model SerpAnalysis {
  id          String    @id @default(cuid())
  workspaceId String
  keyword     String
  rawResults  Json
  analysis    String
  createdAt   DateTime  @default(now())
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@index([workspaceId])
  @@index([workspaceId, keyword])
  @@map("serp_analyses")
}

model StrategyRun {
  id               String    @id @default(cuid())
  workspaceId      String
  status           JobStatus @default(PENDING)
  brandSummary     Json?
  audienceInsights Json?
  contentPillars   Json?
  strategyDoc      Json?
  generatedAt      DateTime?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt
  workspace        Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@index([workspaceId])
  @@map("strategy_runs")
}

model ContentItem {
  id                String           @id @default(cuid())
  userId            String
  workspaceId       String?
  type              ContentType
  channel           ContentChannel
  tone              ContentTone?
  topic             String
  content           String
  status            ContentStatus    @default(DRAFT)
  /// URL-safe identifier for website-published content. Assigned at publish
  /// time and never changed afterwards, so live URLs stay stable.
  slug              String?
  /// Which agent produced this, when it came from one. Lets each agent hold
  /// its own quota instead of sharing one workspace-wide queue.
  agentId           String?
  agent             AutopilotPolicy? @relation(fields: [agentId], references: [id], onDelete: SetNull)
  /// Which storyline this advances. Nullable: content created before the
  /// narrative layer existed has none, and must keep working.
  storylineId       String?
  storyline         Storyline?       @relation(fields: [storylineId], references: [id], onDelete: SetNull)
  creditsCost       Int              @default(0)
  jobId             String?
  scheduledAtUtc    DateTime?
  scheduledTimezone String?
  publishedAtUtc    DateTime?
  failedReason      String?
  campaign          String?
  notes             String?
  createdAt         DateTime         @default(now())
  updatedAt         DateTime         @updatedAt
  user              User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  workspace         Workspace?       @relation(fields: [workspaceId], references: [id])

  images ContentImage[]

  @@unique([workspaceId, slug])
  @@index([userId])
  @@index([workspaceId])
  @@index([workspaceId, status, publishedAtUtc])
  @@index([agentId])
  @@index([storylineId])
  @@map("content_items")
}

/// Generated artwork attached to a content item.
///
/// Stored as bytes in the database rather than on disk: the web app runs on a
/// read-only serverless filesystem, and the Nest publisher needs the raw bytes
/// to upload to LinkedIn, so both sides read the same row.
model ContentImage {
  id            String      @id @default(cuid())
  contentItemId String
  contentItem   ContentItem @relation(fields: [contentItemId], references: [id], onDelete: Cascade)
  workspaceId   String

  data     Bytes
  mimeType String  @default("image/png")
  width    Int?
  height   Int?
  /// The prompt used, so a regeneration can be compared or repeated.
  prompt   String?
  /// Accessibility text published alongside the image.
  altText  String?
  provider String  @default("openai")

  createdAt DateTime @default(now())

  @@index([contentItemId])
  @@index([workspaceId])
  @@map("content_images")
}

model ContentJob {
  id            String     @id @default(cuid())
  userId        String
  workspaceId   String?
  type          JobType
  status        JobStatus  @default(PENDING)
  inputPayload  Json
  outputPayload Json?
  errorMessage  String?
  creditsCost   Int        @default(0)
  createdAt     DateTime   @default(now())
  completedAt   DateTime?
  updatedAt     DateTime   @updatedAt
  user          User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  workspace     Workspace? @relation(fields: [workspaceId], references: [id])

  @@index([userId])
  @@index([status])
  @@map("content_jobs")
}

/// Append-only. Never update rows. Balance = SUM(amount) WHERE userId = ?
model CreditLedger {
  id           String     @id @default(cuid())
  userId       String
  type         LedgerType
  feature      String
  amount       Int
  balanceAfter Int
  jobId        String?
  createdAt    DateTime   @default(now())
  user         User       @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([userId, createdAt])
  @@map("credit_ledger")
}

/// Stores OAuth-connected social media accounts per workspace.
/// Tokens are NEVER stored in plaintext — only refs to encrypted vault entries.
model SocialConnection {
  id                       String                 @id @default(cuid())
  workspaceId              String
  platform                 SocialPlatform
  accountName              String
  accountIdentifier        String
  authProvider             String                 @default("oauth2")
  encryptedAccessTokenRef  String?
  encryptedRefreshTokenRef String?
  scopesJson               Json?
  status                   SocialConnectionStatus @default(CONNECTED)
  isDefault                Boolean                @default(false)
  tokenExpiresAt           DateTime?
  createdAt                DateTime               @default(now())
  updatedAt                DateTime               @updatedAt
  lastSyncAt               DateTime?
  workspace                Workspace              @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  publishJobs              SocialPublishJob[]

  @@index([workspaceId])
  @@index([workspaceId, platform])
  @@map("social_connections")
}

/// A single publish job: one content item → one social destination.
/// Must be processed by a background worker, NOT inside an HTTP request.
model SocialPublishJob {
  id                 String              @id @default(cuid())
  workspaceId        String
  contentItemId      String?
  socialConnectionId String
  platform           SocialPlatform
  scheduledAtUtc     DateTime?
  timezone           String?             @default("UTC")
  status             SocialPublishStatus @default(DRAFT)
  externalPostId     String?
  externalPostUrl    String?
  lastError          String?
  retryCount         Int                 @default(0)
  createdAt          DateTime            @default(now())
  updatedAt          DateTime            @updatedAt
  publishedAtUtc     DateTime?
  connection         SocialConnection    @relation(fields: [socialConnectionId], references: [id], onDelete: Cascade)
  logs               SocialPublishLog[]

  @@index([workspaceId])
  @@index([workspaceId, status])
  @@index([socialConnectionId])
  @@index([scheduledAtUtc, status])
  @@map("social_publish_jobs")
}

/// Append-only audit trail for every action taken on a publish job.
/// Never update rows — only insert.
model SocialPublishLog {
  id              String           @id @default(cuid())
  publishJobId    String
  action          String
  status          String
  requestSummary  String?
  responseSummary String?
  errorMessage    String?
  createdAt       DateTime         @default(now())
  job             SocialPublishJob @relation(fields: [publishJobId], references: [id], onDelete: Cascade)

  @@index([publishJobId])
  @@map("social_publish_logs")
}

/// Immutable AI cost audit trail.
model AiUsageLog {
  id               String   @id @default(cuid())
  userId           String
  model            String
  feature          String
  promptTokens     Int
  completionTokens Int
  totalTokens      Int
  estimatedCostUsd Decimal  @db.Decimal(10, 6)
  jobId            String?
  createdAt        DateTime @default(now())
  user             User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([createdAt])
  @@map("ai_usage_logs")
}

model activity_logs {
  id           String   @id
  user_id      String
  workspace_id String?
  action       String
  detail       Json?
  created_at   DateTime @default(now()) @db.Timestamptz(6)

  @@index([user_id, created_at(sort: Desc)], map: "idx_activity_logs_user_created")
  @@index([workspace_id, created_at(sort: Desc)], map: "idx_activity_logs_workspace_created")
}

model admin_user_controls {
  user_id          String    @id
  access_status    String    @default("ACTIVE")
  suspended_at     DateTime? @db.Timestamptz(6)
  suspended_reason String?
  reactivated_at   DateTime? @db.Timestamptz(6)
  updated_at       DateTime  @default(now()) @db.Timestamptz(6)

  @@index([access_status, updated_at(sort: Desc)], map: "idx_admin_user_controls_status")
}

model admin_workspace_controls {
  workspace_id    String    @id
  is_archived     Boolean   @default(false)
  archived_at     DateTime? @db.Timestamptz(6)
  archived_reason String?
  restored_at     DateTime? @db.Timestamptz(6)
  updated_at      DateTime  @default(now()) @db.Timestamptz(6)

  @@index([is_archived, updated_at(sort: Desc)], map: "idx_admin_workspace_controls_archived")
}

model app_settings {
  key        String   @id
  value      String
  updated_at DateTime @default(now()) @db.Timestamptz(6)
}

model competitor_discovery_runs {
  id                   String   @id
  user_id              String
  workspace_id         String
  run_number           Int
  source               String
  discovered_count     Int      @default(0)
  competitors_snapshot Json
  created_at           DateTime @default(now()) @db.Timestamptz(6)

  @@unique([workspace_id, run_number])
  @@index([user_id, created_at(sort: Desc)], map: "idx_comp_discovery_user_created")
  @@index([workspace_id, created_at(sort: Desc)], map: "idx_comp_discovery_workspace_created")
}

model content_framework_metadata {
  id                    String   @id
  user_id               String
  workspace_id          String
  content_item_id       String?
  event_name            String
  framework_id          String
  framework_name        String
  framework_category    String
  selection_mode        String   @default("auto")
  selection_reason      String?
  goal                  String?
  platform              String?
  funnel_stage          String?
  quality_scores        Json?
  fallback_used         Boolean  @default(false)
  fallback_framework_id String?
  metadata              Json?
  created_at            DateTime @default(now()) @db.Timestamptz(6)

  @@index([content_item_id, created_at(sort: Desc)], map: "idx_framework_metadata_content_item_created")
  @@index([created_at(sort: Desc)], map: "idx_framework_metadata_created")
  @@index([framework_id, created_at(sort: Desc)], map: "idx_framework_metadata_framework_created")
  @@index([workspace_id, created_at(sort: Desc)], map: "idx_framework_metadata_workspace_created")
}

enum UserPlan {
  FREE
  STARTER
  PRO
  AGENCY
}

enum UserRole {
  USER
  ADMIN
}

enum WorkspaceStatus {
  PENDING
  CRAWLING
  ANALYZING
  READY
  ERROR
}

enum ContentChannel {
  linkedin
  twitter
  instagram
  email
  blog
}

enum ContentTone {
  professional
  friendly
  bold
  educational
  persuasive
}

enum ContentType {
  POST
  THREAD
  ARTICLE
  EMAIL
  CAPTION
  OUTLINE
}

enum ContentStatus {
  DRAFT
  GENERATED
  EDITED
  READY
  SCHEDULED
  PUBLISHING
  PUBLISHED
  FAILED
  ARCHIVED
}

enum JobStatus {
  PENDING
  RUNNING
  COMPLETED
  FAILED
}

enum JobType {
  INSTANT_CONTENT
  WEBSITE_CRAWL
  BRAND_ANALYSIS
  STRATEGY_GENERATION
  ARTICLE_DRAFT
}

enum LedgerType {
  ALLOCATION
  CONSUMPTION
  TOP_UP
  REFUND
}

enum SubscriptionStatus {
  ACTIVE
  PAST_DUE
  CANCELED
  TRIALING
  INCOMPLETE
}

enum SocialPlatform {
  LINKEDIN
  X
  FACEBOOK
  INSTAGRAM
  TIKTOK
}

enum SocialConnectionStatus {
  CONNECTED
  EXPIRED
  FAILED
  REVOKED
  PENDING_REAUTH
}

enum SocialPublishStatus {
  DRAFT
  READY
  SCHEDULED
  PUBLISH_QUEUED
  PUBLISHING
  PUBLISHED
  FAILED
  CANCELLED
}

/// What this company can truthfully claim. Deliberately separate from Narrative:
/// evidence is a durable fact about the business, so regenerating the narrative
/// must not throw it away. It also bounds the quality gate — asking a model to
/// tell a story with no real material is how you get invented case studies.
model Evidence {
  id          String       @id @default(cuid())
  workspaceId String
  workspace   Workspace    @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  kind        EvidenceKind
  /// The claim itself, in the founder's words.
  value       String
  /// Optional qualifier: a source, a caveat, a date.
  detail      String?
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt

  @@index([workspaceId])
  @@map("evidence")
}

enum EvidenceKind {
  CUSTOMER_COUNT
  PUBLIC_NUMBER
  NAMED_CUSTOMER
  FIRSTHAND_EXPERIENCE
  /// Workspace-wide prohibition; applies to every storyline.
  FORBIDDEN_CLAIM
}

/// The workspace's position. One per workspace, durable — not a campaign.
/// `change` lives here rather than on Storyline on purpose: if every storyline
/// named its own change, the company would hold four worldviews, which is the
/// incoherence this layer exists to remove.
model Narrative {
  id          String          @id @default(cuid())
  workspaceId String          @unique
  workspace   Workspace       @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  status      NarrativeStatus @default(DRAFT)

  /// Raskin's first element: the shift in the world every storyline hangs off.
  change        String?
  /// Whether `change` was accepted from a proposal or written by hand. If output
  /// quality drops later, this says which narratives were built on a guess.
  changeSource  ChangeSource @default(PROPOSED)
  /// The hypotheses that were offered, kept so a rejected one can be revisited.
  changeOptions Json?

  /// What the intelligence looked like when this was built, so a narrative that
  /// has gone stale is diagnosable six months on.
  sourceSnapshot Json?
  /// Which provider produced the draft, for the same reason.
  generatedBy    String?
  generatedAt    DateTime?

  createdAt  DateTime    @default(now())
  updatedAt  DateTime    @updatedAt
  storylines Storyline[]

  @@map("narratives")
}

enum NarrativeStatus {
  DRAFT
  ACTIVE
  ARCHIVED
}

enum ChangeSource {
  PROPOSED
  EDITED
  HUMAN
}

/// One recurring story, in Andy Raskin's five-element shape rather than fields
/// invented here. Content ladders up to these instead of being 40 disconnected posts.
model Storyline {
  id          String    @id @default(cuid())
  narrativeId String
  narrative   Narrative @relation(fields: [narrativeId], references: [id], onDelete: Cascade)

  /// Raskin 2 — who this shift rewards, and who it leaves behind.
  winners      String?
  losers       String?
  /// Raskin 3 — what the reader's world looks like once they get there.
  promisedLand String
  /// Raskin 4 — capabilities framed as the means of getting there, not a feature list.
  gifts        Json?
  /// Raskin 5 — which Evidence rows this storyline may draw on. Anything not
  /// referenced here is off-limits, and the gate enforces that.
  evidenceIds  String[]

  /// The one-line claim this storyline exists to advance.
  claim    String
  audience String?

  /// Which competitor, matrix position or keyword gap produced this. Without it
  /// a wrong storyline cannot be traced to the wrong input and it becomes taste.
  sourceRefs Json?
  /// Prohibitions specific to this storyline, on top of workspace FORBIDDEN_CLAIMs.
  neverClaim String[]

  position     Int           @default(0)
  enabled      Boolean       @default(true)
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt
  contentItems ContentItem[]

  @@index([narrativeId])
  @@map("storylines")
}

/// Fixed-window rate limit counters.
///
/// Kept in the database rather than in process memory because the web app runs
/// on serverless functions: an in-memory counter would be per-instance, which
/// is exactly no limit at all for the login and sign-up endpoints that need one
/// most. One row per bucket, e.g. "login:ip:203.0.113.4" or
/// "register:email:someone@example.com".
model RateLimit {
  key         String   @id
  count       Int      @default(0)
  /// Start of the current window. Once it is older than the window length the
  /// row is reset rather than deleted, so a busy key stays a single row.
  windowStart DateTime @default(now())

  @@index([windowStart])
  @@map("rate_limits")
}
